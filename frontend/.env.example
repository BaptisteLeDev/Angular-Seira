# Variables exposees au bundle Angular (prefixe NG_APP_*).
# Copier ce fichier en .env (gitignore) et adapter les valeurs.
# Sur Vercel : definir les memes cles dans Project Settings > Environment Variables.

NG_APP_BACKEND_URL=http://localhost:8080/api
NG_APP_PRODUCTION=false

# Production (exemple) :
# NG_APP_BACKEND_URL=https://mon-backend.example.com/api
# NG_APP_PRODUCTION=true
